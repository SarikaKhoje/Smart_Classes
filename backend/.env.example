PORT=5000
HOST=127.0.0.1
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/kashvi_smartclass
JWT_SECRET=
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173

# Razorpay test/live API credentials (required to enable verified online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin default configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234

# Cloudinary (optional) and Gmail SMTP (required for password-reset delivery)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_gmail_app_password
